# Runtime configuration for the admin area and the contact form. Copy to `.env` for local
# development, or supply the same variables to the container in production. `.env` is ignored by
# git and by Docker; never commit real values.
#
# The site's public pages need none of this. Without these variables the marketing pages, the
# sitemap, robots.txt, and llms.txt all still build and serve; only /admin and the contact form
# require configuration.

# The dedicated `h2_website` PostgreSQL database. It is deliberately a separate database from
# any other application on the same server, with its own least-privilege role.
DATABASE_URL="postgresql://h2_website_app:REPLACE_ME@postgres.example.internal:5432/h2_website?schema=public"

# Cloudflare Turnstile keys for a widget registered to h2technologiesllc.com. Do not reuse a
# widget created for another site: the sitekey is bound to its hostname list.
TURNSTILE_SECRET_KEY="REPLACE_ME"
PUBLIC_TURNSTILE_SITE_KEY="REPLACE_ME"
